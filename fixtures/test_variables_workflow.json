{
  "name": "E2E Dynamic Variables Test",
  "description": "Tests CLI variable overrides and parameter resolution in Automa Runner",
  "drawflow": {
    "nodes": [
      {
        "id": "node-trigger",
        "label": "trigger",
        "data": {
          "type": "manual",
          "parameters": [
            {
              "name": "query",
              "defaultValue": "default_runner_query"
            }
          ]
        }
      },
      {
        "id": "node-new-tab",
        "label": "new-tab",
        "data": {
          "url": "https://example.com/?search={{ variables.query }}",
          "active": true
        }
      },
      {
        "id": "node-delay",
        "label": "delay",
        "data": {
          "time": 2000
        }
      }
    ],
    "edges": [
      {
        "id": "edge-1",
        "source": "node-trigger",
        "target": "node-new-tab",
        "sourceHandle": "node-trigger-output-1",
        "targetHandle": "node-new-tab-input-1"
      },
      {
        "id": "edge-2",
        "source": "node-new-tab",
        "target": "node-delay",
        "sourceHandle": "node-new-tab-output-1",
        "targetHandle": "node-delay-input-1"
      }
    ]
  },
  "settings": {
    "debugMode": false,
    "saveLog": true
  }
}
