{
  "name": "E2E Release Multi-Step Automation Pipeline",
  "description": "Complex test verifying parameters, page navigation, DOM inspection, inter-block variable passing, and multi-step chaining",
  "drawflow": {
    "nodes": [
      {
        "id": "node-trigger",
        "label": "trigger",
        "data": {
          "type": "manual",
          "parameters": [
            {
              "name": "targetUrl",
              "defaultValue": "https://example.com"
            },
            {
              "name": "query",
              "defaultValue": "tuquet_release_test"
            }
          ]
        }
      },
      {
        "id": "node-new-tab",
        "label": "new-tab",
        "data": {
          "url": "{{ variables.targetUrl }}/?q={{ variables.query }}",
          "active": true
        }
      },
      {
        "id": "node-js-extract",
        "label": "javascript-code",
        "data": {
          "context": "webpage",
          "timeout": 5000,
          "preloadScripts": [],
          "code": "const title = document.title || 'Example Domain';\nautomaSetVariable('extractedTitle', title);\nconsole.log('Step 1 Title Extracted:', title);\nautomaNextBlock({ title });"
        }
      },
      {
        "id": "node-delay-1",
        "label": "delay",
        "data": {
          "time": 1000
        }
      },
      {
        "id": "node-js-verify",
        "label": "javascript-code",
        "data": {
          "context": "webpage",
          "timeout": 5000,
          "preloadScripts": [],
          "code": "console.log('Step 2 Verifying Variable:', '{{ variables.extractedTitle }}');\nautomaNextBlock();"
        }
      },
      {
        "id": "node-delay-2",
        "label": "delay",
        "data": {
          "time": 500
        }
      }
    ],
    "edges": [
      {
        "id": "edge-1",
        "source": "node-trigger",
        "target": "node-new-tab",
        "sourceHandle": "node-trigger-output-1",
        "targetHandle": "node-new-tab-input-1"
      },
      {
        "id": "edge-2",
        "source": "node-new-tab",
        "target": "node-js-extract",
        "sourceHandle": "node-new-tab-output-1",
        "targetHandle": "node-js-extract-input-1"
      },
      {
        "id": "edge-3",
        "source": "node-js-extract",
        "target": "node-delay-1",
        "sourceHandle": "node-js-extract-output-1",
        "targetHandle": "node-delay-1-input-1"
      },
      {
        "id": "edge-4",
        "source": "node-delay-1",
        "target": "node-js-verify",
        "sourceHandle": "node-delay-1-output-1",
        "targetHandle": "node-js-verify-input-1"
      },
      {
        "id": "edge-5",
        "source": "node-js-verify",
        "target": "node-delay-2",
        "sourceHandle": "node-js-verify-output-1",
        "targetHandle": "node-delay-2-input-1"
      }
    ]
  },
  "settings": {
    "debugMode": false,
    "saveLog": true
  }
}
