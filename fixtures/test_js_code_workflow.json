{
  "name": "E2E JavaScript Code Execution Test",
  "description": "Tests executing custom sandboxed JavaScript code in target browser tab",
  "drawflow": {
    "nodes": [
      {
        "id": "node-trigger",
        "label": "trigger",
        "data": {
          "type": "manual"
        }
      },
      {
        "id": "node-new-tab",
        "label": "new-tab",
        "data": {
          "url": "https://example.com",
          "active": true
        }
      },
      {
        "id": "node-js",
        "label": "javascript-code",
        "data": {
          "code": "console.log('Tuquet JS Execution Success:', document.title);",
          "context": "webpage",
          "preloadScripts": [],
          "timeout": 5000
        }
      },
      {
        "id": "node-delay",
        "label": "delay",
        "data": {
          "time": 2000
        }
      }
    ],
    "edges": [
      {
        "id": "edge-1",
        "source": "node-trigger",
        "target": "node-new-tab",
        "sourceHandle": "node-trigger-output-1",
        "targetHandle": "node-new-tab-input-1"
      },
      {
        "id": "edge-2",
        "source": "node-new-tab",
        "target": "node-js",
        "sourceHandle": "node-new-tab-output-1",
        "targetHandle": "node-js-input-1"
      },
      {
        "id": "edge-3",
        "source": "node-js",
        "target": "node-delay",
        "sourceHandle": "node-js-output-1",
        "targetHandle": "node-delay-input-1"
      }
    ]
  },
  "settings": {
    "debugMode": false,
    "saveLog": true
  }
}
