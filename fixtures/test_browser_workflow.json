{
  "name": "E2E Browser Test Workflow",
  "description": "Opens example.com in Chromium headless, delays 2 seconds, and finishes",
  "drawflow": {
    "nodes": [
      {
        "id": "node-trigger",
        "label": "trigger",
        "data": {
          "type": "manual"
        }
      },
      {
        "id": "node-new-tab",
        "label": "new-tab",
        "data": {
          "url": "https://example.com",
          "active": true
        }
      },
      {
        "id": "node-delay",
        "label": "delay",
        "data": {
          "time": 10000
        }
      }
    ],
    "edges": [
      {
        "id": "edge-1",
        "source": "node-trigger",
        "target": "node-new-tab",
        "sourceHandle": "node-trigger-output-1",
        "targetHandle": "node-new-tab-input-1"
      },
      {
        "id": "edge-2",
        "source": "node-new-tab",
        "target": "node-delay",
        "sourceHandle": "node-new-tab-output-1",
        "targetHandle": "node-delay-input-1"
      }
    ]
  },
  "settings": {
    "debugMode": false,
    "saveLog": true
  }
}
